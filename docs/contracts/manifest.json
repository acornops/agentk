{
  "repo": "agentk",
  "version": 1,
  "runtimeDependencies": ["control-plane"],
  "counterparts": {
    "control-plane": {
      "agentHeaders": ["x-agent-key", "x-connector-version"],
      "connectorVersionHeader": "agentk/<CONNECTOR_VERSION>; required, validated against agentType, and persisted as last_connector_version",
      "agentTypeValues": ["agentk"],
      "handshakeRequestFields": [
        "agentKey",
        "targetId",
        "targetType",
        "agentType",
        "supportedCapabilities",
        "advertisedTools[].name",
        "advertisedTools[].capability",
        "clusterFeatures.metricsApiAvailable",
        "clusterFeatures.rbacMode"
      ],
      "handshakeResponseFields": [
        "workspaceId",
        "targetId",
        "targetType",
        "sessionPolicy.allowedTools",
        "sessionPolicy.writeEnabled",
        "config.snapshotInterval",
        "config.maxSnapshotBytes",
        "config.namespaceScope.include",
        "config.namespaceScope.exclude"
      ],
      "builtinToolNames": [
        "list_resources",
        "get_resource",
        "get_resource_logs",
        "restart_workload",
        "scale_workload",
        "patch_workload",
        "patch_resource",
        "patch_configmap"
      ],
      "kubernetesRbacAdditions": {
        "installValue": "rbac.additions[]",
        "runtimeEnvironment": "ACORNOPS_AGENT_RBAC_ADDITIONS_JSON",
        "verbs": ["get", "list", "patch"],
        "accessMode": "read-only grants configured get and list; read-write additionally grants configured patch",
        "patchBoundary": "JSON Patch add/replace/remove operations under /spec only, with UID and resourceVersion tests, Kubernetes dry-run, ordinary write approval, and post-write identity verification"
      },
      "toolAdvertisementPolicy": "Every registered AgentK tool is advertised and discoverable; session, run, local write, patch-kind, environment, ConfigMap, namespace, and Kubernetes RBAC policy remain fail-closed execution ceilings.",
      "snapshotFields": [
        "metrics.available",
        "metrics.nodes[].usage.{cpu,memory}",
        "resources.pods[].{name,namespace,uid,creationTimestamp,phase,nodeName,restartCount,containerStatuses}",
        "resources.deployments[].{name,namespace,uid,creationTimestamp,replicas,availableReplicas,readyReplicas}",
        "resources.statefulSets[].{name,namespace,uid,creationTimestamp,replicas,availableReplicas,readyReplicas}",
        "resources.daemonSets[].{name,namespace,uid,creationTimestamp,replicas,availableReplicas,readyReplicas}",
        "resources.cronJobs[].{name,namespace,uid,creationTimestamp,schedule,suspend,active,lastScheduleTime}",
        "resources.jobs[].{name,namespace,uid,creationTimestamp,completions,succeeded,failed,active,startTime,completionTime}",
        "resources.services[].{name,namespace,uid,creationTimestamp,type,clusterIP,ports}",
        "resources.ingresses[].{name,namespace,uid,creationTimestamp,hosts,address}",
        "resources.pvcs[].{name,namespace,uid,creationTimestamp,status,capacity,accessModes,storageClass}",
        "resources.nodes[].{name,uid,labels,kubeletVersion,status.conditions}",
        "events[].{involvedObject,reason,message,type,lastTimestamp}"
      ],
      "rpcMethods": ["tools/list", "tools/call", "config/update_namespace_scope"],
      "toolDescriptorFields": [
        "name",
        "description",
        "capability",
        "inputSchema",
        "outputSchema",
        "artifactPolicy",
        "timeout_ms",
        "version",
        "deprecated"
      ],
      "toolCallRequestFields": ["name", "arguments"]
    }
  }
}
